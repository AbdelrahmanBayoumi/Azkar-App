{
  "name": "azkar-gnome-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun tsc",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "lint": "bun --bun eslint . --max-warnings 0",
    "format": "bun --bun prettier --write \"*.{ts,json}\" \"tests/**/*.ts\" ../desktopResources/linux/gnome/azkar-prayers@azkar.app/stylesheet.css",
    "format:check": "bun --bun prettier --check \"*.{ts,json}\" \"tests/**/*.ts\" ../desktopResources/linux/gnome/azkar-prayers@azkar.app/stylesheet.css",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@girs/gjs": "4.9.0",
    "@girs/gnome-shell": "46.0.2"
  }
}
