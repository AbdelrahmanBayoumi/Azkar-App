{
  "name": "azkar-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd site dev",
    "build": "pnpm install --frozen-lockfile --ignore-scripts && ./gradlew :app:captureDownloadScreenshots && bun run build:site",
    "build:site": "bun run --cwd site build",
    "preview": "bun run --cwd site preview",
    "test:site": "bun run --cwd site test",
    "test:browser": "bun run --cwd site test:browser",
    "check": "bun --bun prettier --check package.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json && pnpm -r run check",
    "format": "bun --bun prettier --write package.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json && pnpm -r run format"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "packageManager": "pnpm@12.21.0"
}
